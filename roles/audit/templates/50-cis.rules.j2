## Managed by Ansible. Local changes will be overwritten.
## CIS Benchmark section 6.2.3 (auditd rules). Keys group events for ausearch -k.
{% set arches = ['b64', 'b32'] if ansible_facts['architecture'] == 'x86_64' else ['b64'] %}
{% set uid = audit_uid_min %}

-b {{ audit_backlog_limit }}

## 6.2.3.1 Changes to sudoers (scope)
-w /etc/sudoers -p wa -k scope
-w /etc/sudoers.d -p wa -k scope

## 6.2.3.2 Actions performed as another user
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -C euid!=uid -F auid!=unset -S execve -k user_emulation
{% endfor %}

## 6.2.3.3 Changes to the sudo log
-w {{ audit_sudo_logfile }} -p wa -k sudo_log_file

## 6.2.3.4 Date and time changes
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -S adjtimex,settimeofday,clock_settime -k time-change
{% endfor %}
-w /etc/localtime -p wa -k time-change

## 6.2.3.5 Network environment changes
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -S sethostname,setdomainname -k system-locale
{% endfor %}
-w /etc/issue -p wa -k system-locale
-w /etc/issue.net -p wa -k system-locale
-w /etc/hosts -p wa -k system-locale
-w /etc/hostname -p wa -k system-locale
{% for path in audit_os_network_paths %}
-w {{ path }} -p wa -k system-locale
{% endfor %}

## 6.2.3.7 Unsuccessful file access attempts
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>={{ uid }} -F auid!=unset -k access
-a always,exit -F arch={{ arch }} -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>={{ uid }} -F auid!=unset -k access
{% endfor %}

## 6.2.3.8 User and group identity changes
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/nsswitch.conf -p wa -k identity
-w /etc/pam.conf -p wa -k identity
-w /etc/pam.d -p wa -k identity

## 6.2.3.9 Discretionary access control permission changes
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -S chmod,fchmod,fchmodat -F auid>={{ uid }} -F auid!=unset -k perm_mod
-a always,exit -F arch={{ arch }} -S chown,fchown,lchown,fchownat -F auid>={{ uid }} -F auid!=unset -k perm_mod
-a always,exit -F arch={{ arch }} -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>={{ uid }} -F auid!=unset -k perm_mod
{% endfor %}

## 6.2.3.10 Successful file system mounts
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -S mount -F auid>={{ uid }} -F auid!=unset -k mounts
{% endfor %}

## 6.2.3.11 Session initiation
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session

## 6.2.3.12 Login and logout events
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock -p wa -k logins

## 6.2.3.13 File deletion by users
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -S rename,unlink,unlinkat,renameat -F auid>={{ uid }} -F auid!=unset -k delete
{% endfor %}

## 6.2.3.14 Mandatory access control changes
{% for path in audit_os_mac_paths %}
-w {{ path }} -p wa -k MAC-policy
{% endfor %}

## 6.2.3.18 usermod
-a always,exit -F path=/usr/sbin/usermod -F perm=x -F auid>={{ uid }} -F auid!=unset -k usermod

## 6.2.3.19 Kernel module loading and unloading
{% for arch in arches %}
-a always,exit -F arch={{ arch }} -S init_module,finit_module,delete_module -F auid>={{ uid }} -F auid!=unset -k kernel_modules
{% endfor %}

## Changes to the SSH daemon configuration
-w /etc/ssh/sshd_config -p wa -k sshd_config
{% if audit_extra_rules | length > 0 %}

## Site specific rules
{% for rule in audit_extra_rules %}
{{ rule }}
{% endfor %}
{% endif %}
