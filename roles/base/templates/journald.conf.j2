# Managed by Ansible. Local changes will be overwritten.
[Journal]
Storage={{ base_journald_storage }}
Compress={{ 'yes' if base_journald_compress else 'no' }}
SystemMaxUse={{ base_journald_system_max_use }}
SystemKeepFree={{ base_journald_system_keep_free }}
MaxRetentionSec={{ base_journald_max_retention }}
ForwardToSyslog={{ 'yes' if base_journald_forward_to_syslog else 'no' }}
